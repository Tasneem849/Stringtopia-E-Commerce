PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/stringtopia?retryWrites=true&w=majority
JWT_SECRET=change-me
CLIENT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
CURRENCY=EGP
ADMIN_EMAIL=admin@stringtopia.com
ADMIN_PASSWORD=change-me-too
# Base32 secret for the admin authenticator app. Required for admin sign-in in production.
ADMIN_TOTP_SECRET=
# Shared Vercel-to-API HMAC key for securely forwarding the visitor IP to rate limits.
RATE_LIMIT_PROXY_SECRET=
REQUEST_TTL_DAYS=3
DELIVERY_FEE=5000
PICKUP_ADDRESS=Your business address here
INSTAPAY_ADDRESS=your-InstaPay-alias-or-phone
INSTAPAY_ACCOUNT_NAME=Your account name
INSTAPAY_WHATSAPP=your-WhatsApp-number-with-country-code
INSTAPAY_PAYMENT_TTL_HOURS=24
COD_ORDER_TTL_DAYS=3
# Optional separate HMAC key; if blank, the server reuses JWT_SECRET for IP pseudonymization.
CHECKOUT_IP_HASH_SECRET=

# Email: any SMTP provider (Brevo, Mailgun, Gmail app password...). Leave SMTP_HOST empty to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Stringtopia <you@yourdomain.com>
NOTIFY_EMAIL=you@yourdomain.com

# Product photo and background audio uploads: free account at cloudinary.com (the dashboard shows these three values)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paymob (Egypt): the Paymob dashboard shows the keys, the HMAC secret and your payment integration IDs
PAYMOB_SECRET_KEY=egy_sk_test_...
PAYMOB_PUBLIC_KEY=egy_pk_test_...
PAYMOB_HMAC_SECRET=
# Merchant API key for transaction inquiry and reconciliation (separate from the intention secret key).
PAYMOB_API_KEY=
# comma-separated integration IDs: one for cards, one for mobile wallets, and so on
PAYMOB_INTEGRATION_IDS=
# public https address of this API (on Render it is filled in automatically). Paymob calls it with payment results (use a tunnel like ngrok while developing)
API_URL=https://your-api.example.com
